<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AxisLink.Desktop.ViewModels.Windows.AxisSetup"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="250"
             x:Class="AxisLink.Desktop.Views.Windows.AxisSetup.AxisLimitsSectionView"
             x:DataType="vm:AxisSetupViewModel">

    <StackPanel Spacing="8">
        <DockPanel>
            <TextBlock Text="LIMITS &amp; SENSORS" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="+ New Sensor" 
                    Command="{Binding CreateNewSensorCommand}" 
                    HorizontalAlignment="Right" 
                    Padding="8,4" 
                    FontSize="11"/>
        </DockPanel>
        
        <Grid ColumnDefinitions="*, *, *">
            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                <TextBlock Text="SOFT LIMITS" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="HIGH" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <UnitTextBox Grid.Row="0" Grid.Column="1" Value="{Binding CreatedAxis.HighLimit}" Margin="0,2" Mode="Linear"/>

                    <TextBlock Grid.Row="1" Text="LOW" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <UnitTextBox Grid.Row="1" Grid.Column="1" Value="{Binding CreatedAxis.LowLimit}" Margin="0,2"/>

                    <TextBlock Grid.Row="2" Text="HOME" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <UnitTextBox Grid.Row="2" Grid.Column="1" Value="{Binding HomePosition}" Margin="0,2"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,8,0">
                <TextBlock Text="HARD LIMITS" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="HIGH" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,2"/>

                    <TextBlock Grid.Row="1" Text="LOW" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,2"/>

                    <TextBlock Grid.Row="2" Text="HOME" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,2"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="8">
                <TextBlock Text="ULTIMATE" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="HIGH" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,2"/>

                    <TextBlock Grid.Row="1" Text="LOW" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,2"/>

                    <TextBlock Grid.Row="2" Text="HOME" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,2"/>
                </Grid>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>