<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AxisLink.Desktop.ViewModels.Windows.AxisSetup"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="260"
             x:Class="AxisLink.Desktop.Views.Windows.AxisSetup.AxisLimitsSectionView"
             x:DataType="vm:AxisSetupViewModel">

    <Border Background="{DynamicResource AppSurface}" 
            BorderBrush="{DynamicResource AppBorder}" 
            BorderThickness="1" 
            CornerRadius="6" 
            Padding="16">
        <StackPanel Spacing="12">
            
            <DockPanel>
                <TextBlock Text="LIMITS &amp; SENSORS" 
                           FontWeight="Bold" 
                           FontSize="12" 
                           Foreground="{DynamicResource AppAccent}" 
                           VerticalAlignment="Center"/>
                <Button Content="+ New Sensor" 
                        Command="{Binding CreateNewSensorCommand}" 
                        HorizontalAlignment="Right" 
                        Padding="10,4" 
                        FontSize="11"/>
            </DockPanel>
            
            <Grid ColumnDefinitions="*, 16, *, 16, *">
                
                <!-- SOFT LIMITS -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="SOFT LIMITS" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="45, *">
                        <TextBlock Grid.Row="0" Text="HIGH" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <UnitTextBox Grid.Row="0" Grid.Column="1" Value="{Binding CreatedAxis.HighLimit}" Mode="Linear" Margin="0,3" Height="30"/>

                        <TextBlock Grid.Row="1" Text="LOW" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <UnitTextBox Grid.Row="1" Grid.Column="1" Value="{Binding CreatedAxis.LowLimit}" Mode="Linear" Margin="0,3" Height="30"/>

                        <TextBlock Grid.Row="2" Text="HOME" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <UnitTextBox Grid.Row="2" Grid.Column="1" Value="{Binding HomePosition}" Mode="Linear" Margin="0,3" Height="30"/>
                    </Grid>
                </StackPanel>

                <!-- HARD LIMITS -->
                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="HARD LIMITS" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="45, *">
                        <TextBlock Grid.Row="0" Text="HIGH" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,3" Height="30"/>

                        <TextBlock Grid.Row="1" Text="LOW" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,3" Height="30"/>

                        <TextBlock Grid.Row="2" Text="HOME" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,3" Height="30"/>
                    </Grid>
                </StackPanel>

                <!-- ULTIMATE LIMITS -->
                <StackPanel Grid.Column="4" Spacing="8">
                    <TextBlock Text="ULTIMATE" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="45, *">
                        <TextBlock Grid.Row="0" Text="HIGH" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,3" Height="30"/>

                        <TextBlock Grid.Row="1" Text="LOW" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,3" Height="30"/>

                        <TextBlock Grid.Row="2" Text="HOME" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableSensors}" HorizontalAlignment="Stretch" Margin="0,3" Height="30"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </StackPanel>
    </Border>
</UserControl>