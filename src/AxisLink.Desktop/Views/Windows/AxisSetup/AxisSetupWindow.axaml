<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AxisLink.Desktop.ViewModels.Windows.AxisSetup"
        xmlns:local="using:AxisLink.Desktop.Views.Windows.AxisSetup"
        mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="800"
        x:Class="AxisLink.Desktop.Views.Windows.AxisSetup.AxisSetupWindow"
        x:DataType="vm:AxisSetupViewModel"
        Title="Axis Configuration">

    <Grid RowDefinitions="*, Auto" Margin="16">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                
                <local:AxisControlSectionView DataContext="{Binding}"/>

                <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <Grid ColumnDefinitions="*, 16, *">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="MOTION TYPE" FontWeight="Bold"/>
                        <ComboBox SelectedIndex="{Binding CreatedAxis.Type, FallbackValue=0}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Cross-Stage Line Set"/>
                            <ComboBoxItem Content="Up-Down Line Set"/>
                            <ComboBoxItem Content="Point Hoist"/>
                            <ComboBoxItem Content="Rotary"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="MOTOR TYPE" FontWeight="Bold"/>
                        <ComboBox SelectedIndex="{Binding SelectedMotorTypeIndex}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Constant Speed"/>
                            <ComboBoxItem Content="VFD (Variable Frequency Drive)"/>
                            <ComboBoxItem Content="Stepper Motor"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*, 16, *">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="LOCATION" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="Auto, *, 8, Auto, *">
                            <TextBlock Text="X:" VerticalAlignment="Center"/>
                            <UnitTextBox Grid.Column="1" Value="{Binding CreatedAxis.Location.X}" Mode="Linear"/>
                            <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center"/>
                            <UnitTextBox Grid.Column="4" Value="{Binding CreatedAxis.Location.Y}" Mode="Linear"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox Content="Has Positioning (Encoder Attached)" 
                                  IsChecked="{Binding HasPositioning}"/>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <local:AxisLimitsSectionView DataContext="{Binding}"/>

                <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <StackPanel Spacing="8">
                    <TextBlock Text="MAXIMUMS" FontWeight="Bold"/>
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="120, *">
                        <TextBlock Grid.Row="0" Text="MAX SPEED" VerticalAlignment="Center"/>
                        <UnitTextBox Grid.Row="0" Grid.Column="1" Value="{Binding CreatedAxis.MaxSpeed}" Mode="LinearSpeed" Margin="0,2"/>

                        <TextBlock Grid.Row="1" Text="MAX ACCEL" VerticalAlignment="Center"/>
                        <UnitTextBox Grid.Row="1" Grid.Column="1" Value="{Binding CreatedAxis.MaxAccel}" Mode="LinearAccel" Margin="0,2"/>

                        <TextBlock Grid.Row="2" Text="MAX DECEL" VerticalAlignment="Center"/>
                        <UnitTextBox Grid.Row="2" Grid.Column="1" Value="{Binding CreatedAxis.MaxDecel}" Mode="LinearAccel" Margin="0,2"/>

                        <TextBlock Grid.Row="3" Text="MAX TORQUE" VerticalAlignment="Center"/>
                        <UnitTextBox Grid.Row="3" Grid.Column="1" Value="{Binding CreatedAxis.MaxTorque}" Mode="Percentage" Margin="0,2"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Content="CANCEL" Command="{Binding CancelCommand}" IsCancel="True" Width="80"/>
            <Button Content="SAVE AXIS" Command="{Binding SaveAxisCommand}" IsDefault="True" Classes="accent" Width="100"/>
        </StackPanel>
    </Grid>
</Window>