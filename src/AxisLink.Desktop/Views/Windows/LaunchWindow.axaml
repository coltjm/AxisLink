<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AxisLink.Desktop.ViewModels.Windows"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="AxisLink.Desktop.Views.Windows.LaunchWindow"
        x:DataType="vm:LaunchWindowViewModel"
        WindowDecorations="None"
        Title="Welcome"
        Width="500" Height="350"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource AppBackground}">

    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8">
        <Grid ColumnDefinitions="190, *">
            <!-- LEFT BRANDING PANEL -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource AppSurface}" 
                    BorderBrush="{DynamicResource AppBorder}" 
                    BorderThickness="0,0,1,0" 
                    Padding="20"
                    CornerRadius="7,0,0,7">
                <Grid RowDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="AXISLINK" 
                                   FontSize="20" 
                                   FontWeight="Black" 
                                   LetterSpacing="1.2"
                                   Foreground="{DynamicResource AppAccentText}"/>
                        <TextBlock Text="Show Control" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                    </StackPanel>
                    
                    <!--
                    <Border Grid.Row="1" 
                            VerticalAlignment="Center" 
                            Background="{DynamicResource AppSurfaceInput}" 
                            BorderBrush="{DynamicResource AppBorder}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ANSI E1.44" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}"/>
                            <TextBlock Text="Automation Engine" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </Border> -->

                    <TextBlock Grid.Row="2" 
                               Text="v1.0.0" 
                               FontSize="11" 
                               Foreground="{DynamicResource AppTextSecondary}"/>
                </Grid>
            </Border>

            <!-- RIGHT ACTION BUTTONS -->
            <Grid Grid.Column="1" Margin="28,24" RowDefinitions="Auto, *, Auto">
                <TextBlock Grid.Row="0" 
                           Text="Get Started" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource AppText}"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                    <Button Content="Create New Show..." 
                            Command="{Binding NewShowCommand}"
                            Classes="accent"
                            Height="38"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            CornerRadius="6"/>
                            
                    <Button Content="Open Existing Show..." 
                            Command="{Binding OpenShowCommand}"
                            Height="38"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            CornerRadius="6"/>
                </StackPanel>

                <Button Grid.Row="2" 
                        Content="Exit" 
                        Command="{Binding ExitCommand}"
                        Classes="danger"
                        Height="34"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        CornerRadius="6"/>
            </Grid>
        </Grid>
    </Border>
</Window>