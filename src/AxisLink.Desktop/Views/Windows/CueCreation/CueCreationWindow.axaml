<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:vm="using:AxisLink.Desktop.ViewModels.Windows.CueCreation"
        xmlns:models="using:AxisLink.Core.Models.Standard"
        x:Class="AxisLink.Desktop.Views.Windows.CueCreation.CueCreationWindow"
        x:DataType="vm:CueCreationWindowViewModel"
        WindowStartupLocation="CenterOwner"
        Title="{Binding WindowTitle}">
<Grid RowDefinitions="Auto, *, Auto" Margin="16">
        
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="12" 
                CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto, 12, *, 12, Auto, 12, Auto" RowDefinitions="Auto, 8, Auto">
                
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Cue Number" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBox Text="{Binding Cue.Number}" Width="100" Watermark="e.g. 1.0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical">
                    <TextBlock Text="Cue Name" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBox Text="{Binding Cue.Name}" Watermark="Description / Label"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Vertical">
                    <TextBlock Text="Stack ID" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <NumericUpDown Value="{Binding Cue.Stack}" Width="110" Minimum="0" FormatString="N0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6" Orientation="Vertical">
                    <TextBlock Text="Decision Point ID" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBox Text="{Binding Cue.InteractiveDecisionPoint}" Width="150" Watermark="Optional"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Vertical">
                    <TextBlock Text="Cue Notes" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBox Text="{Binding Cue.Notes}" Height="45" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*, 12, 360">
            
            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Scenery Objects / Cue Parts" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Add Part" Command="{Binding AddCuePartCommand}"/>
                        <Button Content="Remove Part" Command="{Binding RemoveCuePartCommand}" 
                                IsEnabled="{Binding SelectedCuePart, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding CueParts}" 
                          SelectedItem="{Binding SelectedCuePart}"
                          AutoGenerateColumns="False" 
                          CanUserResizeColumns="True"
                          GridLinesVisibility="All"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Obj ID" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Move Type" Binding="{Binding MoveType}" Width="110"/>
                        <DataGridTextColumn Header="Start Type" Binding="{Binding Start.Type}" Width="90"/>
                        <DataGridTextColumn Header="Target Type" Binding="{Binding Target.Type}" Width="90"/>
                        <DataGridTextColumn Header="Speed" Binding="{Binding Target.Speed, StringFormat={}{0:F2}}" Width="80"/>
                        <DataGridTextColumn Header="Delay (s)" Binding="{Binding Target.Delay, StringFormat={}{0:F2}}" Width="70"/>
                        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="80"/>
                        <DataGridTextColumn Header="PB" Binding="{Binding Playback}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="2" Padding="12" CornerRadius="6" 
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    IsEnabled="{Binding SelectedCuePart, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Part Inspector" FontWeight="Bold" FontSize="14"/>
                        
                        <Grid ColumnDefinitions="*, 8, *" RowDefinitions="Auto, Auto">
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="Scenery ID (b_id)" FontSize="11"/>
                                <NumericUpDown Value="{Binding SelectedCuePart.Id, FallbackValue=0}" Minimum="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="Playback" FontSize="11"/>
                                <NumericUpDown Value="{Binding SelectedCuePart.Playback}" Minimum="0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="Move Type" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding AvailableMoveTypes}" 
                                      SelectedItem="{Binding SelectedCuePart.MoveType}" 
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <TextBlock Text="Start Condition" FontWeight="SemiBold"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Start Type" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding AvailableStartTypes}" 
                                      SelectedItem="{Binding SelectedStartType}" 
                                      HorizontalAlignment="Stretch"/>

                            <StackPanel IsVisible="{Binding IsStartAbsolute}">
                                <TextBlock Text="Start Position (mm / deg)" FontSize="11"/>
                                <NumericUpDown Value="{Binding SelectedCuePart.Start.Position}"/>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsStartLimit}">
                                <TextBlock Text="Limit Name" FontSize="11"/>
                                <TextBox Text="{Binding SelectedCuePart.Start.Limit}" Watermark="e.g. lowtrim"/>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsStartTrim}">
                                <TextBlock Text="Trim ID" FontSize="11"/>
                                <NumericUpDown Value="{Binding SelectedCuePart.Start.Trim}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <TextBlock Text="Target &amp; Motion Dynamics" FontWeight="SemiBold"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Target Type" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding AvailableTargetTypes}" 
                                      SelectedItem="{Binding SelectedTargetType}" 
                                      HorizontalAlignment="Stretch"/>

                            <StackPanel IsVisible="{Binding IsTargetAbsolute}">
                                <TextBlock Text="Target Position (mm / deg)" FontSize="11"/>
                                <NumericUpDown Value="{Binding SelectedCuePart.Target.Position}"/>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsTargetRelative}">
                                <TextBlock Text="Relative Distance" FontSize="11"/>
                                <NumericUpDown Value="{Binding SelectedCuePart.Target.Distance}"/>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsTargetLimit}">
                                <TextBlock Text="Target Limit Name" FontSize="11"/>
                                <TextBox Text="{Binding SelectedCuePart.Target.Limit}"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*, 8, *" RowDefinitions="Auto, Auto" Margin="0,6,0,0">
                                <StackPanel Grid.Column="0" Grid.Row="0">
                                    <TextBlock Text="Speed (Req)" FontSize="11"/>
                                    <NumericUpDown Value="{Binding SelectedCuePart.Target.Speed, FallbackValue=0.0}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="Delay (s)" FontSize="11"/>
                                    <NumericUpDown Value="{Binding SelectedCuePart.Target.Delay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,6,0,0">
                                    <TextBlock Text="Accel" FontSize="11"/>
                                    <NumericUpDown Value="{Binding SelectedCuePart.Target.Accel}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,6,0,0">
                                    <TextBlock Text="Decel" FontSize="11"/>
                                    <NumericUpDown Value="{Binding SelectedCuePart.Target.Decel}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Content="Save Cue" Command="{Binding SaveCommand}" IsDefault="True" Classes="accent"/>
        </StackPanel>
        
    </Grid>
</Window>
