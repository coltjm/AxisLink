<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AxisLink.Desktop.ViewModels.Windows.CueCreation"
        xmlns:show="using:AxisLink.Core.Models.Show"
        xmlns:local="using:AxisLink.Desktop.Views.Windows.CueCreation"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:Class="AxisLink.Desktop.Views.Windows.CueCreation.CueCreationWindow"
        x:DataType="vm:CueCreationWindowViewModel"
        WindowStartupLocation="CenterOwner"
        Title="{Binding WindowTitle}">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="16">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="CUE #" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Cue.Number}" Width="80"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <TextBlock Text="NAME:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Cue.Name}" Width="400"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*, 16, 260" Margin="0,0,0,16">
            
            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="CUE PARTS" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="4" Margin="8,0,0,0">
                        <Button Content="+" Command="{Binding AddCuePartCommand}" Width="30" Padding="0"/>
                        <Button Content="-" Command="{Binding RemoveCuePartCommand}" 
                                IsEnabled="{Binding SelectedCuePart, Converter={x:Static ObjectConverters.IsNotNull}}" Width="30" Padding="0"/>
                    </StackPanel>
                </DockPanel>

                <TreeDataGrid Grid.Row="1"
                              Source="{Binding CuePartsSource}"
                              SelectionMode="Row"
                              CanUserResizeColumns="True"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            </Grid>

            <Border Grid.Column="2" 
                    BorderThickness="1" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                    Padding="12" 
                    CornerRadius="4">
                <local:CuePartDetailView DataContext="{Binding}"/>
            </Border>
        </Grid>

        <local:CueTimelineView Grid.Row="2" Height="120" Margin="0,0,0,16" DataContext="{Binding}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Content="SAVE" Command="{Binding SaveCommand}" IsDefault="True" Classes="accent" Width="80"/>
            <Button Content="CANCEL" Command="{Binding CancelCommand}" IsCancel="True" Width="80"/>
        </StackPanel>
        
    </Grid>
</Window>