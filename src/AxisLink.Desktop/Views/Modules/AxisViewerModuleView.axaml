<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extended="using:AxisLink.Core.Models.Extended"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:modules="using:AxisLink.Desktop.ViewModels.Modules"
             xmlns:standard="using:AxisLink.Core.Models.Standard"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AxisLink.Desktop.Views.Modules.AxisViewerModuleView"
             x:DataType="modules:AxisViewerModuleViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding DisplayAxes}" Margin="15">
            
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="extended:ExtendedAxis">
                    <Border Margin="8" 
                            Padding="15" 
                            Background="#252526" 
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid RowDefinitions="Auto, Auto, *, Auto">
                            
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding Name}" 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="#F5F5F5"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Id, StringFormat='ID: {0}'}" 
                                           FontSize="11" 
                                           Foreground="#858585" 
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,15">
                                <Border Background="#4A1515" BorderBrush="#FF5F5F" BorderThickness="1" CornerRadius="3" Padding="6,2"
                                        IsVisible="{Binding HasAlarm}">
                                    <TextBlock Text="FAULTED" FontSize="10" Foreground="#FF8F8F" FontWeight="Bold"/>
                                </Border>
                                
                                <Border Background="#153A15" BorderBrush="#5FFF5F" BorderThickness="1" CornerRadius="3" Padding="6,2"
                                        IsVisible="{Binding IsEnabled}">
                                    <TextBlock Text="ENABLED" FontSize="10" Foreground="#8FFF8F" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Spacing="8" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Current Position" Foreground="#A5A5A5" VerticalAlignment="Bottom"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding CurrentPos, StringFormat='{}{0:F2}'}" FontSize="24" FontWeight="Bold" Foreground="#007ACC"/>
                                        <TextBlock Text=" in" FontSize="14" Foreground="#656565" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </Grid>

                               <!-- <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Target Position" Foreground="#757575"/>
                                    <TextBlock Grid.Column="1" Text="{Binding , StringFormat='{}{0:F2} in'}" Foreground="#D5D5D5"/>
                                </Grid>-->

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Current Velocity" Foreground="#757575"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentVel, StringFormat='{}{0:F1} in/s'}" Foreground="#D5D5D5"/>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Row="3" Margin="0,15,0,0">
                                <ProgressBar Value="{Binding CurrentPos}" 
                                             Minimum="{Binding LowLimit}" 
                                             Maximum="{Binding HighLimit}" 
                                             Height="4" 
                                             Background="#3E3E42" 
                                             Foreground="#007ACC"/>
                            </Grid>
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            
        </ItemsControl>
    </ScrollViewer>
</UserControl>
