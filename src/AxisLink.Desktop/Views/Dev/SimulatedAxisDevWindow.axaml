<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AxisLink.Desktop.ViewModels.Dev"
        x:DataType="vm:SimulatedAxisDevWindowViewModel"
        x:Class="AxisLink.Desktop.Views.Dev.SimulatedAxisDevWindow"
        Title="AxisLink - Virtual Drive / Modbus Diagnostic Port"
        Width="920" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="#181818">

    <Grid ColumnDefinitions="320, 2, *" Margin="12">
        
        <!-- LEFT: Drive State & Controls -->
        <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="14">
            <StackPanel Spacing="14">
                
                <!-- Header / Status -->
                <StackPanel Spacing="4">
                    <TextBlock Text="VIRTUAL CONTROLLER" FontSize="14" FontWeight="Bold" Foreground="#007ACC"/>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="Gray"/>
                </StackPanel>

                <!-- Connection Indicator -->
                <Border CornerRadius="3" Padding="8,4"
                        Background="{Binding IsClientConnected, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding IsClientConnected, StringFormat='Active Session: {0}'}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="#D5D5D5"/>
                </Border>

                <Separator Background="#2A2A2A"/>

                <!-- Kinematic Readouts -->
                <StackPanel Spacing="8">
                    <TextBlock Text="KINEMATIC STATE" FontSize="11" FontWeight="Bold" Foreground="#858585"/>
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Actual Position:" Foreground="#A5A5A5"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentPosition, StringFormat='{}{0:F0} pls'}" FontWeight="Bold" Foreground="#4EC9B0"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Actual Velocity:" Foreground="#A5A5A5"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentVelocity, StringFormat='{}{0:F0} pls/s'}" FontWeight="Bold" Foreground="#4EC9B0"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Target Position:" Foreground="#A5A5A5"/>
                        <TextBlock Grid.Column="1" Text="{Binding TargetPosition, StringFormat='{}{0} pls'}" Foreground="#D5D5D5"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Target Velocity:" Foreground="#A5A5A5"/>
                        <TextBlock Grid.Column="1" Text="{Binding TargetVelocity, StringFormat='{}{0} pls/s'}" Foreground="#D5D5D5"/>
                    </Grid>
                </StackPanel>

                <!-- Status Bits -->
                <StackPanel Spacing="6">
                    <TextBlock Text="COIL FEEDBACK FLAGS" FontSize="11" FontWeight="Bold" Foreground="#858585"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#252526" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="6,2"
                                IsVisible="{Binding BusyFlag}">
                            <TextBlock Text="BUSY (MOVING)" FontSize="10" Foreground="#007ACC" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#4A1515" BorderBrush="#FF5F5F" BorderThickness="1" CornerRadius="3" Padding="6,2"
                                IsVisible="{Binding FaultFlag}">
                            <TextBlock Text="TRIPPED / FAULT" FontSize="10" Foreground="#FF8F8F" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Separator Background="#2A2A2A"/>

                <!-- Fault Injection and Overrides -->
                <StackPanel Spacing="8">
                    <TextBlock Text="SIMULATION OVERRIDES" FontSize="11" FontWeight="Bold" Foreground="#858585"/>

                    <Button Content="Toggle Trip / Fault" 
                            Command="{Binding ToggleFaultCommand}" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#3A1A1A" Foreground="#FF8F8F"/>

                    <Button Content="Zero Position" 
                            Command="{Binding ResetPositionZeroCommand}" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Text="Lag (ms):" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#A5A5A5"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding ArtificialLatencyMs}" Minimum="0" Maximum="2000" Increment="50" FormatString="0"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Background="Transparent"/>

        <!-- RIGHT: Live Traffic & Packet Sniffer -->
        <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid RowDefinitions="Auto, *">
                
                <!-- Sniffer Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                    <TextBlock Text="NETWORK TRAFFIC SNIFFER (MODBUS TCP)" FontWeight="Bold" FontSize="12" Foreground="#858585" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Clear Console" Command="{Binding ClearLogsCommand}" Height="26" FontSize="11"/>
                </Grid>

                <!-- Console Stream -->
                <Border Grid.Row="1" Background="#121212" CornerRadius="3" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrafficLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80, 50, *" Margin="0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#6A9955" FontFamily="Consolas, Monospace" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Direction}" Foreground="{Binding ColorHex}" FontWeight="Bold" FontFamily="Consolas, Monospace" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{Binding ColorHex}" FontFamily="Consolas, Monospace" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>

    </Grid>
</Window>