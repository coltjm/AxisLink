        <b_type xsi:nil="true" />
        <b_length xsi:nil="true" />
        <b_positioning xsi:nil="true" />
        <b_low_limit xsi:nil="true" />
        <b_high_limit xsi:nil="true" />
        <b_speed_type xsi:nil="true" />
        <b_max_speed xsi:nil="true" />
        <b_max_accel xsi:nil="true" />
        <b_max_decel xsi:nil="true" />
        <b_max_load xsi:nil="true" />
        <alink_controller_id>1</alink_controller_id>
        <alink_steps_per_rev>200</alink_steps_per_rev>
        <alink_max_torque xsi:nil="true" />
        <alink_dist_per_rev>100</alink_dist_per_rev>
        <alink_sensors />
