    <b_groups>
      <b_group b_id="0">
        <b_name>main group</b_name>
        <b_type>free</b_type>
        <b_speed_limit>100</b_speed_limit>
        <b_master_axis b_id="0" />
        <b_axis b_id="1">
          <b_offset>200</b_offset>
        </b_axis>
      </b_group>
    </b_groups>
    <b_scenery>
      <b_object b_id="0">
        <b_name>Tree Flyrail</b_name>
        <b_height>400</b_height>
        <b_weight>10</b_weight>
        <b_speed_limit>100</b_speed_limit>
        <b_trims>
          <b_lowtrim>
            <b_name>minimum</b_name>
            <b_position>100</b_position>
          </b_lowtrim>
          <b_hightrim>
            <b_name>maximum</b_name>
            <b_position>1000</b_position>
          </b_hightrim>
          <b_trim b_id="0">
            <b_name>home</b_name>
            <b_position>500</b_position>
          </b_trim>
        </b_trims>
      </b_object>
