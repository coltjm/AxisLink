<Window x:Class="KinetiCUE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"

        Title="{Binding WindowTitle}" Height="650" Width="1000"
        >


    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New Project" Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="Open..." Command="{Binding LoadCommand}"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#444"/>
                <MenuItem Header="Save" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Save As" Command="{Binding SaveAsCommand}"/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <MenuItem Header="Edit">
                <MenuItem Header="Configure Project" Command="{Binding ConfigureProjectCommand}"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#444"/>
                <MenuItem Header="Machine List" Command="{Binding ViewMachineListCommand}"/>
                <MenuItem Header="Add New Machine" Command="{Binding NewMachineCommand}"/>
                <MenuItem Header="Add New PLC" Command="{Binding NewPLCCommand}"/>
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="Reset Spacing" Command="{Binding ResetSpacingCommand}"/>
                <MenuItem Header="Preset Layouts">
                    <MenuItem Header="Programming" Command="{Binding SetLayoutProgrammingCommand}"/>
                    <MenuItem Header="Show Control" Command="{Binding SetLayoutShowControlCommand}"/>
                </MenuItem>
                <MenuItem Header="Customize Layout" Command="{Binding CustomizeLayoutCommand}"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrandPurpleDark}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <TextBlock Text="Kineti" FontWeight="Light" FontSize="20" VerticalAlignment="Center" Opacity="0.8"/>
                        <TextBlock Text="CUE" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text=" | SHOW MODE" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#B39DDB"/>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                         
                        BorderBrush="{Binding EStopColor}" 
                        BorderThickness="1" CornerRadius="2" Padding="20,4">
                        <TextBlock Text="{Binding EStopText}" Foreground="{Binding EStopColor}" FontWeight="Bold"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0">
                        <TextBlock Text="{Binding PlcStatusText}" FontSize="11" VerticalAlignment="Center" 
                                   Foreground="{Binding PlcStatusColor}" Margin="0,0,20,0"/>
                        <Button Content="MENU" Style="{StaticResource FlatButton}" Height="30" Width="80"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Row1Height, Mode=TwoWay}" x:Name="TopRow"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*" x:Name="BottomRow"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Col1Width, Mode=TwoWay}" x:Name="LeftCol"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*" x:Name="RightCol"/>
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource QuadrantStyle}" Content="{Binding TopLeftView}"/>
                <ContentControl Grid.Row="0" Grid.Column="2" Style="{StaticResource QuadrantStyle}" Content="{Binding TopRightView}"/>
                <ContentControl Grid.Row="2" Grid.Column="2" Style="{StaticResource QuadrantStyle}" Content="{Binding BottomLeftView}"/>
                <ContentControl Grid.Row="2" Grid.Column="0" Style="{StaticResource QuadrantStyle}" Content="{Binding BottomRightView}"/>

                <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Background="#000000"/>
                <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" HorizontalAlignment="Stretch" Background="#000000"/>
            </Grid>

            <Border Grid.Row="2" Background="#181818" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <UniformGrid Rows="1" Margin="10">
                        <Button Content="GO" Background="#1B5E20" Foreground="White" FontSize="18" FontWeight="Bold" 
                            BorderThickness="0" Margin="0,0,5,0" Command="{Binding GoCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="STOP" Command="{Binding StopCommand}" Background="#B71C1C" Foreground="White" FontSize="18" FontWeight="Bold"
                             BorderThickness="0" Margin="5,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>

                    <Border Grid.Column="1" Margin="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BackgroundLight}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="AXIS 1: SL WAGON SELECTED" Foreground="{StaticResource BrandPurple}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ready to Jog - Hold Enable" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="20" Background="#333" CornerRadius="2">
                        <TextBlock Text="DEAD MAN: OPEN" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#777" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>