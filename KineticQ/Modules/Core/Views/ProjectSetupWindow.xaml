<Window x:Class="KinetiCUE.Modules.Core.Views.ProjectSetupWindow" x:Name="ProjectSetup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ProjectSetup" Height="450" Width="800" Background="{StaticResource BackgroundDark}">
    <StackPanel Margin="20">
        <TextBlock Text="SAVE PROJECT" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12"/>

        <TextBlock Text="Project Name:" Foreground="{StaticResource TextPrimary}" Margin="0,15,0,5"/>
        <TextBox x:Name="NameInput" Padding="5" Text="{Binding ProjectName}"/>

        <TextBlock Text="Author Name:" Foreground="{StaticResource TextPrimary}" Margin="0,15,0,5"/>
        <TextBox x:Name="AuthorInput" Padding="5" Text="{Binding ProjectAuthor}"/>

        <TextBlock Text="Distance Units:" Foreground="{StaticResource TextPrimary}" Margin="0,15,0,5"/>
        <ComboBox x:Name="UnitsDropdown" Padding="5" SelectedItem="{Binding DistanceUnits}" >
            <ComboBoxItem Content="Meters" />
            <ComboBoxItem Content="Feet (decimal)"/>
            <ComboBoxItem Content="Inches"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=ProjectSetup}" Style="{StaticResource FlatButton}" Width="80"/>
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=ProjectSetup}"
                Style="{StaticResource FlatButton}" 
                Background="{StaticResource BrandPurple}" 
                Width="80" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>