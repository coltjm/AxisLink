<Window x:Class="KinetiCUE.Modules.Core.Views.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="UnsavedChanges"
        Title="Unsaved Changes" Height="150" Width="400"
        Background="{StaticResource BackgroundDark}">
    <StackPanel Margin="20">
        <TextBlock HorizontalAlignment="Center" Text="This project has unsaved changes. Would you like to save?" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12"/>
    
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Don't Save" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=UnsavedChanges}" Style="{StaticResource FlatButton}" Width="80"/>
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=UnsavedChanges}"
                Style="{StaticResource FlatButton}" 
                Background="{StaticResource BrandPurple}" 
                Width="80" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
