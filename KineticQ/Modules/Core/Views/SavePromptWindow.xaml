<Window x:Class="KineticQ.Modules.Core.Views.SavePromptWindow"
        x:Name="SavePrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Project" Height="270" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundDark}">

    <StackPanel Margin="20">
        <TextBlock Text="SAVE PROJECT" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12"/>

        <TextBlock Text="Version Label / Note:" Foreground="{StaticResource TextPrimary}" Margin="0,15,0,5"/>
        <TextBox x:Name="LabelInput" Padding="5" Text="{Binding VersionLabel}"/>

        <CheckBox Content="Mark as Major Milestone" 
                  x:Name="MilestoneCheckbox"
                  IsChecked="{Binding IsMilestone}"
                  Foreground="{StaticResource TextPrimary}" 
                  Margin="0,15,0,0"/>

        <TextBlock Text="(Creates a dedicated backup point)" 
                   Foreground="{StaticResource TextMuted}" 
                   FontSize="10" Margin="20,0,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=SavePrompt}" Style="{StaticResource FlatButton}" Width="80"/>
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=SavePrompt}"
                    Style="{StaticResource FlatButton}" 
                    Background="{StaticResource BrandPurple}" 
                    Width="80" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>