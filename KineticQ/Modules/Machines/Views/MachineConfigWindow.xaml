<Window x:Class="KinetiCUE.Modules.Machines.Views.MachineConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KinetiCUE.Modules.Machines.ViewModels"
        mc:Ignorable="d"
        Title="Machine Configuration" Height="900" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MACHINE CONFIGURATION" 
                       Foreground="{StaticResource TextMuted}" 
                       FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="{Binding Name}" 
                       Foreground="{StaticResource BrandPurpleLight}" 
                       FontSize="24"/>
            <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <TextBlock Text="Identification" Style="{StaticResource DataLabelStyle}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0" Grid.Column="0">
                        <TextBlock Text="ID" Foreground="{StaticResource TextMuted}"/>
                        <TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" Opacity="0.5" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Name" Foreground="{StaticResource TextMuted}"/>
                        <TextBox Text="{Binding Name}" Padding="5"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Mechanics" Style="{StaticResource DataLabelStyle}" Margin="0,0,0,10"/>
                <Border Background="{StaticResource BackgroundLight}" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <CheckBox Content="Linear Axis" IsChecked="{Binding IsLinear}" 
                                  Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Steps / Rev" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding StepsPerRevolution}" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dist / Rev" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding DistPerRevolution}" Padding="5"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Soft Limits &amp; Safety" Style="{StaticResource DataLabelStyle}" Margin="0,0,0,10"/>
                <Border Background="{StaticResource BackgroundLight}" CornerRadius="4" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Max Velocity" Foreground="{StaticResource TextMuted}"/>
                            <TextBox Text="{Binding MaxVelocity}" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Max Acceleration" Foreground="{StaticResource TextMuted}"/>
                            <TextBox Text="{Binding MaxAcceleration}" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Min Position" Foreground="{StaticResource TextMuted}"/>
                            <TextBox Text="{Binding MinPosition}" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Max Position" Foreground="{StaticResource TextMuted}"/>
                            <TextBox Text="{Binding MaxPosition}" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Home Position" Foreground="{StaticResource TextMuted}"/>
                            <TextBox Text="{Binding HomePosition}" Padding="5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="PLC Integration" Style="{StaticResource DataLabelStyle}" Margin="0,0,0,10"/>
                <Border Background="{StaticResource BackgroundLight}" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="IP Address" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding IPAddress}" Padding="5"/>
                            </StackPanel>
                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Port" Foreground="{StaticResource TextMuted}"/>
                                    <TextBox Text="{Binding Port}" Padding="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Unit ID" Foreground="{StaticResource TextMuted}"/>
                                    <TextBox Text="{Binding UnitId}" Padding="5"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="0" Grid.Row="2">
                                <TextBlock Text="Move Coil (Go Signal)" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding Addr_MoveCmd}" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="2">
                                <TextBlock Text="Status Bit (Moving Status)" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding Addr_StatusBit}" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="4">
                                <TextBlock Text="Target Position Register" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding Addr_TargetPos}" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="4">
                                <TextBlock Text="Current Position Register" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding Addr_CurrentPos}" Padding="5"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="0" Grid.Row="6">
                                <TextBlock Text="Target Velocity Register" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding Addr_TargetVel}" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="6">
                                <TextBlock Text="Fault Bit" Foreground="{StaticResource TextMuted}"/>
                                <TextBox Text="{Binding Addr_FaultBit}" Padding="5"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" 
                    Style="{StaticResource FlatButton}" Width="100" Margin="0,0,10,0"/>

            <Button Content="Save Changes" Command="{Binding SaveCommand}" 
                    Style="{StaticResource FlatButton}" Width="120"
                    BorderBrush="{StaticResource BrandPurple}"
                    Background="{StaticResource BrandPurpleDark}"/>
        </StackPanel>
    </Grid>
</Window>