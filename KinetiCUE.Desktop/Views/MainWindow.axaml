<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KinetiCUE.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:desktop="using:KinetiCUE.Desktop"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:modules="using:KinetiCUE.Desktop.Views.Modules"
        xmlns:dockFactory="using:Dock.Model.Avalonia"
        xmlns:dockModel="using:Dock.Model.Avalonia.Controls"
        mc:Ignorable="d" 
        d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="KinetiCUE.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="KinetiCUE">  

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    

   <DockPanel>
        
        <Menu DockPanel.Dock="Top" Background="{DynamicResource KQMenuBackground}" Foreground="{DynamicResource KQText}">
            
            <MenuItem Header="_File">
                <MenuItem Header="_New Show" Command="{Binding NewShowCommand}"/>
                <MenuItem Header="_Open Show..." Command="{Binding OpenShowCommand}"/>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding SaveShowCommand}"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsShowCommand}"/>
                <Separator/>
                <MenuItem Header="_Exit" Command="{Binding ExitApplicationCommand}"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGesture="Ctrl+Z"/>
                <MenuItem Header="Redo" InputGesture="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cut" InputGesture="Ctrl+X"/>
                <MenuItem Header="Copy" InputGesture="Ctrl+C"/>
                <MenuItem Header="Paste" InputGesture="Ctrl+V"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Show Log Console" IsChecked="{Binding IsLogConsoleVisible, Mode=TwoWay}"/>
                <MenuItem Header="Open Motor Axis Viewer" Command="{Binding ShowAxisViewerCommand}"/>
                <MenuItem Header="Open Master Cue Sheet" Command="{Binding ShowCueSheetCommand}"/>
                <Separator/>
                <MenuItem Header="Reset Window Layout"/>
            </MenuItem>

            <MenuItem Header="_Config">
                <MenuItem Header="New Controller..." Command="{Binding OpenNewControllerWindowCommand}"/>
                <MenuItem Header="Network / Modbus Settings..."/>
                <MenuItem Header="Motor Profiles..."/>
                <MenuItem Header="User Preferences..."/>
            </MenuItem>
            
        </Menu>

        <Border DockPanel.Dock="Top" Height="40" BorderThickness="0,0,0,1" BorderBrush="#333333" Padding="5,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="System Status: Ready" VerticalAlignment="Center" FontSize="12" Foreground="LightGreen" FontFamily="Courier New"/>
            </StackPanel>
        </Border>

        <DockControl InitializeLayout="True" InitializeFactory="True" Margin="5">
            <DockControl.Factory>
                <dockFactory:Factory />
            </DockControl.Factory>
            
            <dockModel:RootDock Id="Root" Title="Root">
                <dockModel:ProportionalDock Id="MainLayout" Orientation="Horizontal">
            
                    <dockModel:ToolDock Id="LayoutAnchor" Proportion="0.0" MinWidth="0" MaxWidth="0" CanFloat="False" >
                        </dockModel:ToolDock>
            
                    <dockModel:DocumentDock Id="DocumentsPane" 
                                            Proportion="1.0"
                                            CanCreateDocument="False"
                                            ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Workspace.ActiveModules}">
                
                        <dockModel:DocumentDock.DocumentTemplate>
                            <dockModel:DocumentTemplate x:DataType="dockModel:Document">
                                <ContentControl Content="{Binding Context}" />
                            </dockModel:DocumentTemplate>
                        </dockModel:DocumentDock.DocumentTemplate>
                
                    </dockModel:DocumentDock>
            
                </dockModel:ProportionalDock>
            </dockModel:RootDock>
        </DockControl>
        
    </DockPanel>

    
</Window>
