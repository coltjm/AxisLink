<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KinetiCUE.Desktop.ViewModels.Windows"
        x:Class="KinetiCUE.Desktop.Views.Windows.ControllerSetupWindow"
        x:DataType="vm:ControllerSetupViewModel"
        Title="Configure New Controller"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Add Hardware Controller" FontSize="18" FontWeight="Bold"/>
        
        <StackPanel Spacing="5">
            <TextBlock Text="Controller Name:"/>
            <TextBox Text="{Binding ControllerName}"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="IP Address:"/>
            <TextBox Text="{Binding IpAddress}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Save Controller" Command="{Binding SaveAndCloseCommand}" Classes="accent"/>
        </StackPanel>
    </StackPanel>
</Window>